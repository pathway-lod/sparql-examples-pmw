@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:po2 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "PO-2. The metabolite matches a PlantMetWiki pathway (as in PO-1) and the gene is an ortholog of a gene that PlantMetWiki lists in that pathway in another species. The orthology is read from the graph as lodp:orthologOf (for example from OrthoDB groups, see tier 5 of the pathway-component queries); the gene of the other species is matched to the pathway by its UniProt accession. NOT RUNNABLE ON THE CURRENT GRAPHS: orthologs are not in the RDF yet."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "case 6: paired omics, transcript-metabolite associations" , "PO-2" , "evidence tier" , "gene-metabolite association" , "paired omics" , "orthologs" , "OrthoDB" , "metabolite annotation" , "InChIKey" , "UniProt" , "PlantMetWiki pathway" , "federated query" , "local evidence graph" , "no data yet" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?association ?pathway ?gene ?orthologUniprot WHERE {
  ?association a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?feature , ?gene .
  ?feature a lodp:MetaboliteFeature .
  ?gene lodp:orthologOf ?orthologUniprot .
  ?annotation a lodp:MetaboliteAnnotation ; lodp:feature ?feature ; skos:closeMatch ?key .
  BIND(SUBSTR(STRAFTER(STR(?key), "inchikey/"), 1, 14) AS ?block1)
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?pathway ?block1 ?orthologUniprot WHERE {
      ?enzymeNode dcterms:isPartOf ?gp ; v:gpmlProperty ?bu . ?bu v:key "AlternativeId_Uniprot" ; v:value ?acc .
      BIND(IRI(CONCAT("http://purl.uniprot.org/uniprot/", STR(?acc))) AS ?orthologUniprot)
      ?metNode dcterms:isPartOf ?gp ; v:gpmlProperty ?bm . ?bm v:key "InchiKey" ; v:value ?ik .
      BIND(SUBSTR(STRAFTER(?ik, "InChIKey="), 1, 14) AS ?block1)
      BIND(REPLACE(STR(?gp), "^.*/Pathway/(PC[0-9]+)_.*$", "$1") AS ?pathway)
    }
  }
}
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

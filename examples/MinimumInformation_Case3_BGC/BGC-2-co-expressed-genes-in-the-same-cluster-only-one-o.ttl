@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:bgc2 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "BGC-2. As BGC-1, and only one of the two genes is listed in a PlantMetWiki pathway (by its Solyc locus). This is a lead to extend that pathway with the other gene. NOT RUNNABLE ON THE CURRENT GRAPHS (see BGC-1). TESTED 2026-11-10: 0 rows in 149 s on the association graph and the sample graph."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "case 3: plantiSMASH-predicted BGCs, predicted gene clusters" , "BGC-2" , "evidence tier" , "biosynthetic gene cluster" , "plantiSMASH" , "co-expression" , "gene" , "Solyc locus" , "PlantMetWiki pathway" , "pathway expansion" , "federated query" , "local evidence graph" , "no data yet" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?cluster ?geneInPathway ?geneNotInPathway ?pathway WHERE {
  ?cluster a obo:SO_0002357 ; obo:BFO_0000051 ?partA , ?partB .
  ?assocA a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneA ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  ?assocB a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneB ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  FILTER(STR(?geneA) < STR(?geneB))
  BIND(REPLACE(STR(?geneA), "^.*[?&]g=", "") AS ?locusA)
  BIND(REPLACE(STR(?geneB), "^.*[?&]g=", "") AS ?locusB)
  FILTER(STRENDS(STR(?partA), ?locusA) && STRENDS(STR(?partB), ?locusB))
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?locusA ?pathway WHERE {
      ?geneNode dcterms:isPartOf ?gp ; v:gpmlProperty ?bg . ?bg v:value ?gv .
      FILTER(REGEX(STR(?gv), "^Solyc[0-9]+g[0-9]+", "i"))
      BIND(CONCAT("Solyc", SUBSTR(STR(?gv), 6, 9)) AS ?locus)
      BIND(REPLACE(STR(?gp), "^.*/Pathway/(PC[0-9]+)_.*$", "$1") AS ?pathway)
    }
  }
  FILTER NOT EXISTS { SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> { ?n v:gpmlProperty ?bn . ?bn v:value ?vn . FILTER(CONTAINS(STR(?vn), ?locusB)) } }
  BIND(?locusA AS ?geneInPathway) BIND(?locusB AS ?geneNotInPathway)
}
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

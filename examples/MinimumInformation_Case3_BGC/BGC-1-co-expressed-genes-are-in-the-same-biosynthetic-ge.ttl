@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:bgc1 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "BGC-1. Two genes that are co-expressed (here: genes associated with the same metabolite feature in the same MEANtools functional cluster) are both parts of the same plantiSMASH biosynthetic gene cluster (cluster obo:BFO_0000051 gene). Returns the pairs and the cluster. NOT RUNNABLE ON THE CURRENT GRAPHS: the cluster graph lists only the genes linked to a pathway, not all genes of the cluster, and the tomato clusters are not in the RDF."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "case 3: plantiSMASH-predicted BGCs, predicted gene clusters" , "BGC-1" , "evidence tier" , "biosynthetic gene cluster" , "plantiSMASH" , "co-expression" , "gene-metabolite association" , "MEANtools" , "gene" , "local evidence graph" , "no data yet" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX obo: <http://purl.obolibrary.org/obo/>

SELECT ?cluster ?geneA ?geneB ?functionalCluster WHERE {
  ?assocA a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneA ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  ?assocB a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneB ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  FILTER(STR(?geneA) < STR(?geneB) && STRSTARTS(STR(?geneA), "https://plants.ensembl.org/") && STRSTARTS(STR(?geneB), "https://plants.ensembl.org/"))
  BIND(REPLACE(STR(?geneA), "^.*[?&]g=", "") AS ?locusA)
  BIND(REPLACE(STR(?geneB), "^.*[?&]g=", "") AS ?locusB)
  ?cluster a obo:SO_0002357 ; obo:BFO_0000051 ?partA , ?partB .
  FILTER(STRENDS(STR(?partA), ?locusA) && STRENDS(STR(?partB), ?locusB))
}
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> .

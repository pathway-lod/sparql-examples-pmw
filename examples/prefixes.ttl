prefix sh: <http://www.w3.org/ns/shacl#>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix owl: <http://www.w3.org/2002/07/owl#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>

_:sparql_examples_prefixes
  a owl:Ontology ;
  owl:imports sh: .

_:sparql_examples_prefixes sh:declare _:prefix_rdf .
_:prefix_rdf
  sh:prefix "rdf" ;
  sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_rdfs .
_:prefix_rdfs
  sh:prefix "rdfs" ;
  sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_skos .
_:prefix_skos
  sh:prefix "skos" ;
  sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_owl .
_:prefix_owl
  sh:prefix "owl" ;
  sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_xsd .
_:prefix_xsd
  sh:prefix "xsd" ;
  sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_v .
_:prefix_v
  sh:prefix "v" ;
  sh:namespace "http://rdf-plantmetwiki.bioinformatics.nl/vocab/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_gpml .
_:prefix_gpml
  sh:prefix "gpml" ;
  sh:namespace "http://vocabularies.wikipathways.org/gpml#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_wp .
_:prefix_wp
  sh:prefix "wp" ;
  sh:namespace "http://vocabularies.wikipathways.org/wp#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_dcterms .
_:prefix_dcterms
  sh:prefix "dcterms" ;
  sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_rh .
_:prefix_rh
  sh:prefix "rh" ;
  sh:namespace "http://rdf.rhea-db.org/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_up .
_:prefix_up
  sh:prefix "up" ;
  sh:namespace "http://purl.uniprot.org/core/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_lodp .
_:prefix_lodp
  sh:prefix "lodp" ;
  sh:namespace "https://example.org/lod-pathways/pilot/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_sio .
_:prefix_sio
  sh:prefix "sio" ;
  sh:namespace "http://semanticscience.org/resource/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_prov .
_:prefix_prov
  sh:prefix "prov" ;
  sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_obo .
_:prefix_obo
  sh:prefix "obo" ;
  sh:namespace "http://purl.obolibrary.org/obo/"^^xsd:anyURI .

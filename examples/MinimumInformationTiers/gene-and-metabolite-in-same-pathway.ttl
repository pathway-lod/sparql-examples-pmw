@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:gene-and-metabolite-in-same-pathway a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "gene-and-metabolite-in-same-pathway: An association of a gene and a metabolite feature where the gene (by its Solyc locus, listed in PlantMetWiki) and the metabolite (by an InChIKey first-block match of an annotation of the feature) are in the same PlantMetWiki pathway. Both sides are computed here; the stored anchor terms are not used. NOTE: the associations of the MEANtools pilot (MTBLS1039) have m/z values only and no annotation in the RDF, so the metabolite side returns no rows on the current graphs; `gene-in-plantmetwiki-pathway` shows the gene side alone. OUTPUT: a list of genes (supported members of a pathway: a gene associated with a metabolite that is in the same pathway, matched by Solyc locus and InChIKey); the number of associations and of metabolite features that support each gene-pathway pair are metadata."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 6: paired omics, transcript-metabolite associations" , "case 5: metabolomics, metabolite annotations" , "gene-metabolite association" , "paired omics" , "MEANtools" , "metabolite annotation" , "InChIKey" , "gene" , "Solyc locus" , "PlantMetWiki pathway" , "federated query" , "local evidence graph" , "output: genes" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?component ?componentType ?pathway
       (COUNT(DISTINCT ?association) AS ?supportingAssociations)
       (COUNT(DISTINCT ?feature) AS ?supportingMetaboliteFeatures)
WHERE {
  ?association a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?feature , ?component .
  ?feature a lodp:MetaboliteFeature .
  FILTER(STRSTARTS(STR(?component), "https://plants.ensembl.org/"))
  BIND(REPLACE(STR(?component), "^.*[?&]g=", "") AS ?locus)
  BIND("gene" AS ?componentType)
  
  ?annotation a lodp:MetaboliteAnnotation ; lodp:feature ?feature ; skos:closeMatch ?mkey .
  FILTER(STRSTARTS(STR(?mkey), "https://identifiers.org/inchikey/"))
  BIND(SUBSTR(STRAFTER(STR(?mkey), "inchikey/"), 1, 14) AS ?block1)
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?block1 ?locus ?pathway WHERE {
      ?geneNode dcterms:isPartOf ?gp ; v:gpmlProperty ?bg . ?bg v:value ?gv .
      FILTER(REGEX(STR(?gv), "^Solyc[0-9]+g[0-9]+", "i"))
      BIND(CONCAT("Solyc", SUBSTR(STR(?gv), 6, 9)) AS ?locus)
      ?metNode dcterms:isPartOf ?gp ; v:gpmlProperty ?bm . ?bm v:key "InchiKey" ; v:value ?ik .
      BIND(SUBSTR(STRAFTER(?ik, "InChIKey="), 1, 14) AS ?block1)
      BIND(REPLACE(STR(?gp), "^.*/Pathway/([A-Z]+[0-9]+)_.*$", "$1") AS ?pathway)
    }
  }
}
GROUP BY ?component ?componentType ?pathway
ORDER BY DESC(?supportingAssociations)
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:gene-catalyses-the-transformation a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "gene-catalyses-the-transformation: A gene is associated with two metabolite features. Both are matched to PlantMetWiki metabolites (`annotation-matches-plantmetwiki`), and PlantMetWiki has a conversion from one to the other (substrate to product) catalysed by an enzyme that the gene is linked to (here by its UniProt accession, lodp:uniprot). Returns the gene, the two metabolites and the conversion. NOT RUNNABLE ON THE CURRENT GRAPHS: the associations have no second metabolite per gene with an annotation, and no gene-to-UniProt link in the RDF."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 6: paired omics, transcript-metabolite associations" , "case 5: metabolomics, metabolite annotations" , "case 2: inferred enzyme function from PMN/PlantCyc+ db" , "gene-metabolite association" , "paired omics" , "enzyme" , "UniProt" , "PlantMetWiki reaction" , "substrate and product" , "metabolite annotation" , "InChIKey" , "federated query" , "local evidence graph" , "no data yet" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT ?gene ?featureA ?featureB ?conversion ?uniprot WHERE {
  ?assocA a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?featureA , ?gene .
  ?assocB a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?featureB , ?gene .
  ?featureA a lodp:MetaboliteFeature . ?featureB a lodp:MetaboliteFeature .
  FILTER(STR(?featureA) < STR(?featureB))
  ?gene lodp:uniprot ?uniprot .
  ?annA a lodp:MetaboliteAnnotation ; lodp:feature ?featureA ; skos:closeMatch ?keyA .
  ?annB a lodp:MetaboliteAnnotation ; lodp:feature ?featureB ; skos:closeMatch ?keyB .
  BIND(SUBSTR(STRAFTER(STR(?keyA), "inchikey/"), 1, 14) AS ?blockA)
  BIND(SUBSTR(STRAFTER(STR(?keyB), "inchikey/"), 1, 14) AS ?blockB)
  BIND(STRAFTER(STR(?uniprot), "uniprot/") AS ?acc)
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?blockA ?blockB ?acc ?conversion WHERE {
      ?conversion a wp:Conversion ; wp:source ?mA ; wp:target ?mB .
      ?cat a wp:Catalysis ; wp:target ?conversion ; wp:source ?enzyme .
      ?mA v:gpmlProperty ?b1 . ?b1 v:key "InchiKey" ; v:value ?ika .
      ?mB v:gpmlProperty ?b2 . ?b2 v:key "InchiKey" ; v:value ?ikb .
      ?enzyme v:gpmlProperty ?b3 . ?b3 v:key "AlternativeId_Uniprot" ; v:value ?acc .
      BIND(SUBSTR(STRAFTER(?ika, "InChIKey="), 1, 14) AS ?blockA)
      BIND(SUBSTR(STRAFTER(?ikb, "InChIKey="), 1, 14) AS ?blockB)
    }
  }
}
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

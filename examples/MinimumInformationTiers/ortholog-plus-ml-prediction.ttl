@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:ortholog-plus-ml-prediction a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "ortholog-plus-ml-prediction: As in `ortholog-in-pathway-species`, and the transformation also matches an enzymatic transformation predicted by a model on the PlantMetWiki graph (case 7, for example the predictions of PlantMetBench): a predicted link between the enzyme the gene is an ortholog of and a reaction that connects the two metabolites. The prediction is read as lodp:PredictedLink with lodp:predictionScore and the model run. NOT RUNNABLE ON THE CURRENT GRAPHS: no predictions are in the RDF yet."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 6: paired omics, transcript-metabolite associations" , "case 7: unsupervised GNN predictions of reactions (conversion steps)" , "gene-metabolite association" , "paired omics" , "orthologs" , "machine learning prediction" , "predicted enzymatic transformation" , "local evidence graph" , "no data yet" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>

SELECT ?gene ?enzyme ?reaction ?score ?run WHERE {
  ?association a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?feature , ?gene .
  ?gene lodp:orthologOf ?enzyme .
  ?prediction a lodp:PredictedLink ; lodp:predictedEnzyme ?enzyme ; lodp:predictedReaction ?reaction ;
              lodp:predictionScore ?score ; sio:SIO_000772/prov:wasGeneratedBy ?run .
}
ORDER BY DESC(?score)
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> .

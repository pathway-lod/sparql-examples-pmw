@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:coexpressed-in-cluster-one-in-pathway a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "coexpressed-in-cluster-one-in-pathway: As in `coexpressed-in-same-cluster`, and only one of the two genes is listed in a PlantMetWiki pathway (by its Solyc locus). This is a lead to extend that pathway with the other gene. NOT RUNNABLE ON THE CURRENT GRAPHS (see `coexpressed-in-same-cluster`). OUTPUT: a list of genes (putative members of a pathway: a gene that is not listed in PlantMetWiki but is co-expressed with, and in the same biosynthetic gene cluster as, a gene that is in the pathway); the pathway, the gene it is inferred from and the cluster are metadata."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 3: plantiSMASH-predicted BGCs, predicted gene clusters" , "case 4: transcriptomics, gene co-expression values" , "case 6: paired omics, transcript-metabolite associations" , "biosynthetic gene cluster" , "plantiSMASH" , "co-expression" , "gene" , "Solyc locus" , "PlantMetWiki pathway" , "pathway expansion" , "federated query" , "local evidence graph" , "no data yet" , "output: genes" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?component ?componentType ?pathway ?viaGene ?cluster WHERE {
  ?cluster a obo:SO_0002357 ; obo:BFO_0000051 ?partA , ?partB .
  ?assocA a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneA ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  ?assocB a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneB ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  FILTER(?geneA != ?geneB)
  BIND(REPLACE(STR(?geneA), "^.*[?&]g=", "") AS ?viaGene)
  BIND(REPLACE(STR(?geneB), "^.*[?&]g=", "") AS ?component)
  FILTER(STRENDS(STR(?partA), ?viaGene) && STRENDS(STR(?partB), ?component))
  BIND("gene" AS ?componentType)
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?viaGene ?pathway WHERE {
      ?geneNodeviaGene dcterms:isPartOf ?gpviaGene ; v:gpmlProperty ?bgviaGene . ?bgviaGene v:value ?gvviaGene .
      FILTER(REGEX(STR(?gvviaGene), "^Solyc[0-9]+g[0-9]+", "i"))
      BIND(CONCAT("Solyc", SUBSTR(STR(?gvviaGene), 6, 9)) AS ?viaGene)
      BIND(REPLACE(STR(?gpviaGene), "^.*/Pathway/([A-Z]+[0-9]+)_.*$", "$1") AS ?pathway)
    }
  }
  FILTER NOT EXISTS { SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> { ?nB v:gpmlProperty ?bB . ?bB v:value ?vB . FILTER(CONTAINS(STR(?vB), ?component)) } }
}
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:structure-similarity a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "structure-similarity: Proxy for a structure similarity. Two detected metabolites of the same dataset are matched to PlantMetWiki metabolites (`annotation-matches-plantmetwiki`) and the two InChIs share the same formula layer but not the same connectivity (they are related structures: isomers). A true fingerprint similarity (for example Tanimoto) cannot be computed in SPARQL; when precomputed values are in the graph (as in `similarity-link`) they replace this proxy. OUTPUT: a list of putative metabolites of a pathway: PlantMetWiki metabolites with a related structure (here a proxy: the same InChI formula layer) to a metabolite of the pathway, both matched by detected metabolites (the pathway, the metabolite it is inferred from and the formula layer are metadata)."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 5: metabolomics, metabolite annotations" , "metabolite annotation" , "metabolite feature" , "InChI" , "InChIKey" , "structure similarity" , "PlantMetWiki metabolite" , "federated query" , "local evidence graph" , "output: metabolites" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?component ?componentType ?pathway ?viaMetabolite ?formulaLayer WHERE {
  ?annA a lodp:MetaboliteAnnotation ; lodp:feature ?featureA ; skos:closeMatch ?keyA .
  FILTER(STRSTARTS(STR(?keyA), "https://identifiers.org/inchikey/"))
  BIND(SUBSTR(STRAFTER(STR(?keyA), "inchikey/"), 1, 14) AS ?blockA)
  ?annB a lodp:MetaboliteAnnotation ; lodp:feature ?featureB ; skos:closeMatch ?keyB .
  FILTER(STRSTARTS(STR(?keyB), "https://identifiers.org/inchikey/"))
  BIND(SUBSTR(STRAFTER(STR(?keyB), "inchikey/"), 1, 14) AS ?blockB)
  ?featureA lodp:dataset ?dataset . ?featureB lodp:dataset ?dataset .
  FILTER(?blockA != ?blockB)
  BIND("metabolite" AS ?componentType)
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?blockA ?viaMetabolite ?pathway ?formulaLayer WHERE {
      ?nodeA dcterms:isPartOf ?gp ; v:gpmlProperty ?a1 , ?a2 . ?a1 v:key "InchiKey" ; v:value ?ika . ?a2 v:key "Inchi" ; v:value ?inchiA .
      BIND(STRAFTER(?ika, "InChIKey=") AS ?viaMetabolite)
      BIND(SUBSTR(?viaMetabolite, 1, 14) AS ?blockA)
      BIND(STRBEFORE(STRAFTER(?inchiA, "InChI=1S/"), "/") AS ?formulaLayer)
      BIND(REPLACE(STR(?gp), "^.*/Pathway/([A-Z]+[0-9]+)_.*$", "$1") AS ?pathway)
    }
  }
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?blockB ?component ?formulaLayer WHERE {
      ?nodeB v:gpmlProperty ?b1 , ?b2 . ?b1 v:key "InchiKey" ; v:value ?ikb . ?b2 v:key "Inchi" ; v:value ?inchiB .
      BIND(STRAFTER(?ikb, "InChIKey=") AS ?component)
      BIND(SUBSTR(?component, 1, 14) AS ?blockB)
      BIND(STRBEFORE(STRAFTER(?inchiB, "InChI=1S/"), "/") AS ?formulaLayer)
    }
  }
}
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

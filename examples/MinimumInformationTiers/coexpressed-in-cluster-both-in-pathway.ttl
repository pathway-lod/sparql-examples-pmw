@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:coexpressed-in-cluster-both-in-pathway a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "As in `coexpressed-in-same-cluster`, and both genes are listed in a PlantMetWiki pathway (by their Solyc loci); returns the pathways of the two genes and whether it is the same pathway. NOT RUNNABLE ON THE CURRENT GRAPHS (see `coexpressed-in-same-cluster`). TESTED 2026-11-10: did NOT finish within 280 s (two unbound federated calls to PlantMetWiki); needs a LIMIT or a cached lookup."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 3: plantiSMASH-predicted BGCs, predicted gene clusters" , "case 4: transcriptomics, gene co-expression values" , "case 6: paired omics, transcript-metabolite associations" , "biosynthetic gene cluster" , "plantiSMASH" , "co-expression" , "gene" , "Solyc locus" , "PlantMetWiki pathway" , "federated query" , "local evidence graph" , "no data yet" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?cluster ?locusA ?locusB ?pathwayA ?pathwayB (?pathwayA = ?pathwayB AS ?samePathway) WHERE {
  ?cluster a obo:SO_0002357 ; obo:BFO_0000051 ?partA , ?partB .
  ?assocA a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneA ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  ?assocB a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneB ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  FILTER(STR(?geneA) < STR(?geneB))
  BIND(REPLACE(STR(?geneA), "^.*[?&]g=", "") AS ?locusA)
  BIND(REPLACE(STR(?geneB), "^.*[?&]g=", "") AS ?locusB)
  FILTER(STRENDS(STR(?partA), ?locusA) && STRENDS(STR(?partB), ?locusB))
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?locusA ?pathwayA WHERE {
      ?nA dcterms:isPartOf ?gA ; v:gpmlProperty ?bA . ?bA v:value ?vA .
      FILTER(REGEX(STR(?vA), "^Solyc[0-9]+g[0-9]+", "i"))
      BIND(CONCAT("Solyc", SUBSTR(STR(?vA), 6, 9)) AS ?locusA)
      BIND(REPLACE(STR(?gA), "^.*/Pathway/(PC[0-9]+)_.*$", "$1") AS ?pathwayA)
    }
  }
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?locusB ?pathwayB WHERE {
      ?nB dcterms:isPartOf ?gB ; v:gpmlProperty ?bB . ?bB v:value ?vB .
      FILTER(REGEX(STR(?vB), "^Solyc[0-9]+g[0-9]+", "i"))
      BIND(CONCAT("Solyc", SUBSTR(STR(?vB), 6, 9)) AS ?locusB)
      BIND(REPLACE(STR(?gB), "^.*/Pathway/(PC[0-9]+)_.*$", "$1") AS ?pathwayB)
    }
  }
}
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

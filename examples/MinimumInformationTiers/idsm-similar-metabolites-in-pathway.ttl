@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:idsm-similar-metabolites-in-pathway a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "idsm-similar-metabolites-in-pathway: For the directed conversions of one PlantMetWiki pathway (here PC968, alpha-tomatine biosynthesis; change the identifier), finds the ChEBI compounds that are structurally similar (Sachem similarity of at least 0.98) to the source and to the target metabolite of each conversion, using the IDSM chemical structure search service. May be slower because it depends on the external IDSM endpoint. TESTED 2026-11-11 on the public endpoints: returns rows in about 1 s."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "IDSM" , "Sachem" , "chemical similarity search" , "structure similarity" , "ChEBI" , "metabolite" , "federated query" , "runs on public endpoints" , "case 2: inferred enzyme function from PMN/PlantCyc+ db" , "case 5: metabolomics, metabolite annotations" , "PlantMetWiki pathway" , "conversion" , "substrate and product" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX sso: <http://semanticscience.org/resource/>
PREFIX sachem: <http://bioinfo.uochb.cas.cz/rdf/v1.0/sachem#>

SELECT DISTINCT ?sourceChebi ?similarToSource ?targetChebi ?similarToTarget WHERE {
  ?pw a wp:Pathway ; dcterms:identifier "PC968" .
  ?conversion a wp:Conversion ; dcterms:isPartOf ?pw ; wp:source ?source ; wp:target ?target .
  BIND(CONCAT("InChIKey=", STRAFTER(STR(?source), "inchikey/")) AS ?ikSource)
  BIND(CONCAT("InChIKey=", STRAFTER(STR(?target), "inchikey/")) AS ?ikTarget)
  ?mSource dcterms:isPartOf ?gp ; v:gpmlProperty ?s1 , ?s2 . ?s1 v:key "InchiKey" ; v:value ?ikSource . ?s2 v:key "AlternativeId_Chebi" ; v:value ?chebiSource .
  ?mTarget dcterms:isPartOf ?gp ; v:gpmlProperty ?t1 , ?t2 . ?t1 v:key "InchiKey" ; v:value ?ikTarget . ?t2 v:key "AlternativeId_Chebi" ; v:value ?chebiTarget .
  FILTER(STRSTARTS(STR(?gp), "http://rdf-plantmetwiki.bioinformatics.nl/Pathway/PC968_r"))
  BIND(IRI(CONCAT("http://purl.obolibrary.org/obo/CHEBI_", STR(?chebiSource))) AS ?sourceChebi)
  BIND(IRI(CONCAT("http://purl.obolibrary.org/obo/CHEBI_", STR(?chebiTarget))) AS ?targetChebi)
  SERVICE <https://idsm.elixir-czech.cz/sparql/endpoint/chebi> {
    ?sourceChebi ^sso:is-attribute-of / sso:has-value ?molfileSource .
    ?targetChebi ^sso:is-attribute-of / sso:has-value ?molfileTarget .
    [ sachem:compound ?similarToSource ; sachem:score ?scoreSource ]
      sachem:similaritySearch [ sachem:query ?molfileSource ; sachem:cutoff 9.8e-1 ] .
    [ sachem:compound ?similarToTarget ; sachem:score ?scoreTarget ]
      sachem:similaritySearch [ sachem:query ?molfileTarget ; sachem:cutoff 9.8e-1 ] .
  }
}
LIMIT 100""" ;
    schema:target <https://plantmetwiki.bioinformatics.nl/sparql> ;
    spex:federatesWith <https://idsm.elixir-czech.cz/sparql/endpoint/chebi> .

@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:coexpressed-in-same-cluster a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "coexpressed-in-same-cluster: Two genes that are co-expressed (here: genes associated with the same metabolite feature in the same MEANtools functional cluster) are both parts of the same plantiSMASH biosynthetic gene cluster (cluster obo:BFO_0000051 gene). Returns the pairs and the cluster. Needs the tomato cluster graph of the plantiSMASH pilot (pilots/plantismash_overlap/results/bgc_tomato.ttl, built by build_tomato_bgc.py: the genes of the 63 tomato clusters that map to a Solyc locus, about half of the cluster genes). On the MEANtools pilot only 6 of the 350 genes are in a tomato cluster, so it finds few or no pairs. OUTPUT: a list of genes (putatively in the same pathway: co-expressed genes that lie in the same biosynthetic gene cluster), with the cluster, the partner gene and the functional cluster of the co-expression as metadata."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 3: plantiSMASH-predicted BGCs, predicted gene clusters" , "case 4: transcriptomics, gene co-expression values" , "case 6: paired omics, transcript-metabolite associations" , "biosynthetic gene cluster" , "plantiSMASH" , "co-expression" , "gene-metabolite association" , "MEANtools" , "gene" , "local evidence graph"  , "output: genes" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX obo: <http://purl.obolibrary.org/obo/>

SELECT ?component ?componentType ?cluster ?partnerGene ?functionalCluster WHERE {
  ?assocA a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneA ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  ?assocB a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneB ; sio:SIO_000772/lodp:functionalCluster ?functionalCluster .
  FILTER(STR(?geneA) < STR(?geneB) && STRSTARTS(STR(?geneA), "https://plants.ensembl.org/") && STRSTARTS(STR(?geneB), "https://plants.ensembl.org/"))
  BIND(REPLACE(STR(?geneA), "^.*[?&]g=", "") AS ?locusA)
  BIND(REPLACE(STR(?geneB), "^.*[?&]g=", "") AS ?locusB)
  # the genes of the clusters are Ensembl Plants gene IRIs, the same as in the associations (see pilots/plantismash_overlap/build_tomato_bgc.py), so the join is exact
  ?cluster a obo:SO_0002357 ; obo:BFO_0000051 ?geneA , ?geneB .
  BIND(?geneA AS ?component) BIND(?geneB AS ?partnerGene)
  BIND("gene" AS ?componentType)
}
LIMIT 100""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> .

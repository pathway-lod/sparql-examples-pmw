@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:gene-in-plantmetwiki-pathway a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "gene-in-plantmetwiki-pathway: Gene side of `gene-and-metabolite-in-same-pathway`. The gene of each association is looked up in PlantMetWiki by its Solyc locus (tier gene_locus), by its UniProt entry (gene_uniprot, from the gene annotation graph) or by an EC number of its UniProt entry that is on a reaction of the pathway (gene_ec, weak), and the pathways are returned with the tier that found them. Counts the associations whose gene is in at least one pathway. OUTPUT: a list of genes (supported members of a pathway: the gene of an association is listed in a PlantMetWiki pathway by its Solyc locus, by its UniProt entry or, weakly, by an EC number), with the number of associations that support each gene-pathway pair as metadata."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 6: paired omics, transcript-metabolite associations" , "gene-metabolite association" , "paired omics" , "MEANtools" , "gene" , "Solyc locus" , "PlantMetWiki pathway" , "federated query" , "local evidence graph" , "output: genes" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX gpml: <http://vocabularies.wikipathways.org/gpml#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?component ?componentType ?pathway ?tier (COUNT(DISTINCT ?association) AS ?supportingAssociations) WHERE {
  ?association a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?component .
  FILTER(STRSTARTS(STR(?component), "https://plants.ensembl.org/"))
  BIND(REPLACE(STR(?component), "^.*[?&]g=", "") AS ?locus)
  BIND("gene" AS ?componentType)
  {
    # tier gene_locus: the Solyc locus is listed in the pathway
    SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
      SELECT DISTINCT ?locus ?pathway WHERE {
        ?geneNode dcterms:isPartOf ?gp ; v:gpmlProperty ?bg . ?bg v:value ?gv .
        FILTER(REGEX(STR(?gv), "^Solyc[0-9]+g[0-9]+", "i"))
        BIND(CONCAT("Solyc", SUBSTR(STR(?gv), 6, 9)) AS ?locus)
        BIND(REPLACE(STR(?gp), "^.*/Pathway/([A-Z]+[0-9]+)_.*$", "$1") AS ?pathway)
      }
    }
    BIND("gene_locus" AS ?tier)
  } UNION {
    # tier gene_uniprot: the UniProt entry of the gene is listed in the pathway
    ?component lodp:uniprot ?uniprotEntry .
    BIND(STRAFTER(STR(?uniprotEntry), "uniprot/") AS ?acc)
    SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
      SELECT DISTINCT ?acc ?pathway WHERE {
        ?uniprotNode dcterms:isPartOf ?gpU ; v:gpmlProperty ?bU . ?bU v:key "AlternativeId_Uniprot" ; v:value ?acc .
        BIND(REPLACE(STR(?gpU), "^.*/Pathway/([A-Z]+[0-9]+)_.*$", "$1") AS ?pathway)
      }
    }
    BIND("gene_uniprot" AS ?tier)
  } UNION {
    # tier gene_ec: an EC number of the gene is on a reaction of the pathway (weak: an EC number is shared by many genes)
    ?component lodp:ecNumber ?ec .
    SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
      SELECT DISTINCT ?ec ?pathway WHERE {
        ?reactionNode a gpml:Interaction ; dcterms:isPartOf ?gpE ; v:gpmlProperty ?bE . ?bE v:key "EC_Number" ; v:value ?ecValue .
        FILTER(REGEX(STR(?ecValue), "^EC-[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$"))
        BIND(STRAFTER(STR(?ecValue), "EC-") AS ?ec)
        BIND(REPLACE(STR(?gpE), "^.*/Pathway/([A-Z]+[0-9]+)_.*$", "$1") AS ?pathway)
      }
    }
    BIND("gene_ec" AS ?tier)
  }
}
GROUP BY ?component ?componentType ?pathway ?tier
ORDER BY DESC(?supportingAssociations)""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

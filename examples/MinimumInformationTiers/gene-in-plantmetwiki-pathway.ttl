@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:gene-in-plantmetwiki-pathway a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "gene-in-plantmetwiki-pathway: Gene side of `gene-and-metabolite-in-same-pathway`. The gene of each association is looked up in PlantMetWiki by its Solyc locus and the pathways that list it are returned. Counts the associations whose gene is in at least one pathway. OUTPUT: a list of genes (supported members of a pathway: the gene of an association is listed in a PlantMetWiki pathway by its Solyc locus), with the number of associations that support each gene-pathway pair as metadata."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 6: paired omics, transcript-metabolite associations" , "gene-metabolite association" , "paired omics" , "MEANtools" , "gene" , "Solyc locus" , "PlantMetWiki pathway" , "federated query" , "local evidence graph" , "output: genes" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?component ?componentType ?pathway (COUNT(DISTINCT ?association) AS ?supportingAssociations) WHERE {
  ?association a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?component .
  FILTER(STRSTARTS(STR(?component), "https://plants.ensembl.org/"))
  BIND(REPLACE(STR(?component), "^.*[?&]g=", "") AS ?locus)
  BIND("gene" AS ?componentType)
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?locus ?pathway WHERE {
      ?geneNodelocus dcterms:isPartOf ?gplocus ; v:gpmlProperty ?bglocus . ?bglocus v:value ?gvlocus .
      FILTER(REGEX(STR(?gvlocus), "^Solyc[0-9]+g[0-9]+", "i"))
      BIND(CONCAT("Solyc", SUBSTR(STR(?gvlocus), 6, 9)) AS ?locus)
      BIND(REPLACE(STR(?gplocus), "^.*/Pathway/([A-Z]+[0-9]+)_.*$", "$1") AS ?pathway)
    }
  }
}
GROUP BY ?component ?componentType ?pathway
ORDER BY DESC(?supportingAssociations)""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:gene-in-plantmetwiki-pathway a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "gene-in-plantmetwiki-pathway: Gene side of `gene-and-metabolite-in-same-pathway`. The gene of each association is looked up in PlantMetWiki by its Solyc locus and the pathways that list it are returned. Counts the associations whose gene is in at least one pathway. TESTED 2026-11-10: on the 1,293 associations of the MEANtools pilot (association.ttl) no gene is listed by its Solyc locus in a PlantMetWiki pathway (0 rows). The two pathways PC70 and PC968 that appear when the sample graph is loaded as well come from its single association (GAME17, Solyc07g043480)."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 6: paired omics, transcript-metabolite associations" , "gene-metabolite association" , "paired omics" , "MEANtools" , "gene" , "Solyc locus" , "PlantMetWiki pathway" , "federated query" , "local evidence graph" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?pathway (COUNT(DISTINCT ?association) AS ?associations) WHERE {
  ?association a lodp:GeneMetaboliteAssociation ; sio:SIO_000628 ?geneIri .
  FILTER(STRSTARTS(STR(?geneIri), "https://plants.ensembl.org/"))
  BIND(REPLACE(STR(?geneIri), "^.*[?&]g=", "") AS ?gene)
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?pathway ?gene WHERE {
      ?geneNode dcterms:isPartOf ?gp ; v:gpmlProperty ?bg . ?bg v:value ?gv .
      FILTER(REGEX(STR(?gv), "^Solyc[0-9]+g[0-9]+", "i"))
      BIND(CONCAT("Solyc", SUBSTR(STR(?gv), 6, 9)) AS ?gene)
      BIND(REPLACE(STR(?gp), "^.*/Pathway/(PC[0-9]+)_.*$", "$1") AS ?pathway)
    }
  }
}
GROUP BY ?pathway
ORDER BY DESC(?associations)""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

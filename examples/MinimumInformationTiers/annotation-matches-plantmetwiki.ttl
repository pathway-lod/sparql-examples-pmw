@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:annotation-matches-plantmetwiki a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "annotation-matches-plantmetwiki: A detected metabolite (feature) is annotated by at least one tool with an InChIKey whose first block (connectivity) equals that of a PlantMetWiki metabolite. The match is computed here, by comparing the first InChIKey block of each annotation with the PlantMetWiki metabolites; no stored anchor or match term is used. Returns, per feature, the number of tools whose annotation matches. OUTPUT: a list of metabolites (the PlantMetWiki metabolites that a detected metabolite is annotated as) with their putative pathways; the number of features and of annotation tools that support each one are metadata."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 5: metabolomics, metabolite annotations" , "metabolite annotation" , "metabolite feature" , "InChIKey" , "PlantMetWiki metabolite" , "annotation tool" , "federated query" , "local evidence graph" , "output: metabolites" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?component ?componentType ?pathway
       (COUNT(DISTINCT ?feature) AS ?supportingFeatures)
       (COUNT(DISTINCT ?tool) AS ?supportingTools)
       (GROUP_CONCAT(DISTINCT ?tool; separator=", ") AS ?tools)
WHERE {
  ?annotation a lodp:MetaboliteAnnotation ; lodp:feature ?feature ; skos:closeMatch ?key ;
      sio:SIO_000772/prov:wasGeneratedBy/lodp:software ?tool .
  FILTER(STRSTARTS(STR(?key), "https://identifiers.org/inchikey/"))
  BIND(SUBSTR(STRAFTER(STR(?key), "inchikey/"), 1, 14) AS ?block1)
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?block1 ?pmwKey ?pathway WHERE {
      ?pmwNode dcterms:isPartOf ?gp ; v:gpmlProperty ?bk . ?bk v:key "InchiKey" ; v:value ?ik .
      BIND(STRAFTER(?ik, "InChIKey=") AS ?pmwKey)
      BIND(SUBSTR(?pmwKey, 1, 14) AS ?block1)
      BIND(REPLACE(STR(?gp), "^.*/Pathway/([A-Z]+[0-9]+)_.*$", "$1") AS ?pathway)
    }
  }
  BIND(IRI(CONCAT("https://identifiers.org/inchikey/", ?pmwKey)) AS ?component)
  BIND("metabolite" AS ?componentType)
}
GROUP BY ?component ?componentType ?pathway
ORDER BY DESC(?supportingTools) DESC(?supportingFeatures)""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .

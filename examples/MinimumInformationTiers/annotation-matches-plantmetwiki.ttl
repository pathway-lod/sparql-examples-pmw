@prefix ex: <https://pathway-lod.github.io/sparql-examples-pmw/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:annotation-matches-plantmetwiki a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "A detected metabolite (feature) is annotated by at least one tool with an InChIKey whose first block (connectivity) equals that of a PlantMetWiki metabolite. The match is computed here, by comparing the first InChIKey block of each annotation with the PlantMetWiki metabolites; no stored anchor or match term is used. Returns, per feature, the number of tools whose annotation matches. TESTED 2026-11-10: on the 2,722 annotations of the Brassicaceae pilot it returned 2,015 features with a match, in about 63 s."@en ;
    schema:keywords "Minimum Information: evidence tiers" , "evidence tier" , "case 5: metabolomics, metabolite annotations" , "metabolite annotation" , "metabolite feature" , "InChIKey" , "PlantMetWiki metabolite" , "annotation tool" , "federated query" , "local evidence graph" ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX lodp: <https://example.org/lod-pathways/pilot/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX v: <http://rdf-plantmetwiki.bioinformatics.nl/vocab/>

SELECT ?feature (COUNT(DISTINCT ?tool) AS ?toolsMatching) (SAMPLE(?pmwMetabolite) AS ?exampleMetabolite) WHERE {
  ?annotation a lodp:MetaboliteAnnotation ; lodp:feature ?feature ; skos:closeMatch ?key .
  FILTER(STRSTARTS(STR(?key), "https://identifiers.org/inchikey/"))
  BIND(SUBSTR(STRAFTER(STR(?key), "inchikey/"), 1, 14) AS ?block1)
  ?annotation sio:SIO_000772/prov:wasGeneratedBy/lodp:software ?tool .
  SERVICE <https://plantmetwiki.bioinformatics.nl/sparql> {
    SELECT DISTINCT ?block1 ?pmwMetabolite WHERE {
      ?pmwMetabolite v:gpmlProperty ?bk . ?bk v:key "InchiKey" ; v:value ?ik .
      BIND(SUBSTR(STRAFTER(?ik, "InChIKey="), 1, 14) AS ?block1)
    }
  }
}
GROUP BY ?feature
ORDER BY DESC(?toolsMatching)""" ;
    schema:target <https://pathway-lod.github.io/sparql-examples-pmw/evidence-graph> ;
    spex:federatesWith <https://plantmetwiki.bioinformatics.nl/sparql> .
